{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "packages/web/dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "https://api-production-af19.up.railway.app/auth/$1" },
    { "source": "/health", "destination": "https://api-production-af19.up.railway.app/health" },
    { "source": "/health/(.*)", "destination": "https://api-production-af19.up.railway.app/health/$1" },
    { "source": "/api/(.*)", "destination": "https://api-production-af19.up.railway.app/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
