FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium ffmpeg \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10.23.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/marketing/package.json packages/marketing/package.json

RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY packages/marketing packages/marketing

RUN pnpm --filter @chartsuno/shared build \
  && pnpm --filter @chartsuno/marketing build

ENV NODE_ENV=production
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN mkdir -p /data

CMD ["node", "packages/marketing/dist/server.js"]
