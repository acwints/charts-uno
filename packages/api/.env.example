# Environment
ENVIRONMENT=development

# JWT Secret (min 32 characters in production)
JWT_SECRET_KEY=your-secret-key-min-32-characters-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Google AI (Gemini) - for chart analysis and recommendations
GOOGLE_API_KEY=your-google-ai-api-key

# BigQuery public datasets (optional real-data source for prompt research)
# Requires a service-account JSON with BigQuery permissions in BIGQUERY_PROJECT_ID.
ENABLE_BIGQUERY_PUBLIC_DATA=false
BIGQUERY_PROJECT_ID=
# Either set BIGQUERY_CREDENTIALS_FILE or GOOGLE_APPLICATION_CREDENTIALS
BIGQUERY_CREDENTIALS_FILE=
# Or pass the JSON itself (plain JSON string or base64-encoded JSON)
BIGQUERY_CREDENTIALS_JSON=

# Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_FRONTEND_DOMAINS=
PUBLIC_APP_URL=https://chartsuno.com

# Internal bot -> API bridge (required for bot-created public chart links)
BOT_INTERNAL_API_TOKEN=your_shared_internal_token
# Choose a real existing Chartsuno user as owner for bot-created charts
BOT_CHART_OWNER_ID=
BOT_CHART_OWNER_EMAIL=

# Database (Railway provides these automatically)
# DATABASE_URL=postgresql://user:pass@host:port/db
# Or individual PostgreSQL variables:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=railway

# Server
PORT=8080
HOST=0.0.0.0

# Polar.sh (for subscriptions/billing)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_BUSINESS=
