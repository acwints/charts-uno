# Twitter API credentials (OAuth 2.0)
TWITTER_CLIENT_ID=your_client_id
TWITTER_CLIENT_SECRET=your_client_secret

# Optional OAuth 1.0a fallback credentials
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Bot configuration
BOT_USER_ID=your_bot_user_id
ALLOWED_USER_IDS=user_id_1,user_id_2

# Google API key for Gemini
GOOGLE_API_KEY=your_google_api_key

# Chartsuno API integration (required for unified web+bot AI flow)
BOT_API_URL=http://localhost:8080
BOT_INTERNAL_API_TOKEN=your_shared_internal_token

# Optional: Poll interval in milliseconds (default: 60000)
POLL_INTERVAL_MS=60000

# Optional: Path to bot state file (default: /data/bot-state.json)
BOT_STATE_PATH=/data/bot-state.json

# Optional: seed OAuth2 state for stateless deployments (raw JSON or base64 JSON)
BOT_STATE_JSON=
