FROM node:22-bookworm-slim

WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/bot/package.json packages/bot/package.json

RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY packages/bot packages/bot

RUN pnpm --filter @chartsuno/shared build && pnpm --filter @chartsuno/bot build

ENV NODE_ENV=production
ENV PORT=8080
ENV BOT_STATE_PATH=/data/bot-state.json

RUN mkdir -p /data && cp packages/bot/bot-state.json /data/bot-state.json || true

CMD ["node", "packages/bot/dist/index.js"]
