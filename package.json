{
  "name": "chartsuno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "pnpm --filter @chartsuno/web dev",
    "dev:bot": "pnpm --filter @chartsuno/bot dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @chartsuno/shared build && pnpm --filter @chartsuno/web build",
    "build:bot": "pnpm --filter @chartsuno/bot build",
    "check:harness": "node scripts/check-harness.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "mobile:ios:sync": "pnpm --filter @chartsuno/mobile ios:sync",
    "mobile:ios:open": "pnpm --filter @chartsuno/mobile ios:open",
    "eval:charts": "python3 scripts/eval-chart-generation.py",
    "eval:charts:live": "python3 scripts/eval-chart-generation.py --live",
    "preview": "pnpm --filter @chartsuno/web preview"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "beautiful-mermaid": "^0.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "sharp"
    ],
    "overrides": {
      "serialize-javascript@<7.0.3": "^7.0.3",
      "postcss@8": "^8.5.31",
      "js-yaml@4": "^4.2.0",
      "@babel/core@7": "^7.29.6",
      "fast-uri@3": "^3.1.9",
      "d3-color@<3.1.0": "^3.1.0",
      "nanoid@3": "^3.3.16",
      "postcss-selector-parser@7": "^7.1.6",
      "browserslist@4": "^4.28.7",
      "baseline-browser-mapping@2": "^2.11.0",
      "source-map-js@1": "^1.2.2",
      "fast-copy@3": "^3.1.0"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
