{
  "name": "chartsuno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @chartsuno/web dev",
    "dev:bot": "pnpm --filter @chartsuno/bot dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @chartsuno/shared build && pnpm --filter @chartsuno/web build",
    "build:bot": "pnpm --filter @chartsuno/bot build",
    "check:harness": "node scripts/check-harness.mjs",
    "lint": "pnpm -r lint",
    "mobile:ios:sync": "pnpm --filter @chartsuno/mobile ios:sync",
    "mobile:ios:open": "pnpm --filter @chartsuno/mobile ios:open",
    "eval:charts": "python3 scripts/eval-chart-generation.py",
    "eval:charts:live": "python3 scripts/eval-chart-generation.py --live",
    "preview": "pnpm --filter @chartsuno/web preview"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "beautiful-mermaid": "^0.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "sharp"
    ]
  }
}
